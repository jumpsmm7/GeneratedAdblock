$TTL 30
$ORIGIN nobypass.rpz.
@ IN SOA localhost hostmaster.nobypass.rpz. (
 2608110946 ; Serial Number
 300 ; Refresh Period
 1800 ; Retry Period
 604800 ; Expire Time
 30 ; Negative Caching TTL
 )
 NS localhost

dns1.nextdns.io CNAME .
*.dns1.nextdns.io CNAME .
dns2.nextdns.io CNAME .
*.dns2.nextdns.io CNAME .
dns.nextdns.io CNAME .
*.dns.nextdns.io CNAME .
firefox.dns.nextdns.io CNAME .
*.firefox.dns.nextdns.io CNAME .
