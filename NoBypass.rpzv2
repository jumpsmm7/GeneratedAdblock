$TTL 30
$ORIGIN nobypass.rpz.
@ IN SOA localhost hostmaster.nobypass.rpz. (
 2608100959 ; Serial Number
 300 ; Refresh Period
 1800 ; Retry Period
 604800 ; Expire Time
 30 ; Negative Caching TTL
 )
 NS localhost

dns1.nextdns.io A 0.0.0.0
*.dns1.nextdns.io A 0.0.0.0
dns1.nextdns.io AAAA ::
*.dns1.nextdns.io AAAA ::
dns2.nextdns.io A 0.0.0.0
*.dns2.nextdns.io A 0.0.0.0
dns2.nextdns.io AAAA ::
*.dns2.nextdns.io AAAA ::
dns.nextdns.io A 0.0.0.0
*.dns.nextdns.io A 0.0.0.0
dns.nextdns.io AAAA ::
*.dns.nextdns.io AAAA ::
firefox.dns.nextdns.io A 0.0.0.0
*.firefox.dns.nextdns.io A 0.0.0.0
firefox.dns.nextdns.io AAAA ::
*.firefox.dns.nextdns.io AAAA ::
